# ======================================================================
# Copia este archivo como `.env` y ajusta los valores según tu entorno.
# Todas las variables son OPCIONALES: el proyecto ya trae valores por defecto.
# ======================================================================

# ---- Django -------------------------------------------------------------
# SECRET_KEY=cambia-esto-en-produccion
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Ollama (IA local) --------------------------------------------------
# URL del servidor local de Ollama.
OLLAMA_API_URL=http://localhost:11434/api/generate

# Modelo personalizado ya registrado con:
#   ollama create pos-inventario-bot -f Modelfile.txt
OLLAMA_MODELO=pos-inventario-bot

# Timeout en segundos (CPU es lento; no bajar de 60).
OLLAMA_TIMEOUT=120